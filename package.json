{
  "name": "chess-club",
  "version": "1.0.0",
  "private": true,
  "description": "A friendly, kid-oriented chess app with an interactive coach. Runs entirely in the browser and deploys to Cloudflare Workers.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir=.dryrun",
    "serve": "node scripts/serve.mjs",
    "test": "node test-all.mjs",
    "test:smoke": "node smoke-test.mjs",
    "test:e2e": "node e2e-test.mjs",
    "test:worker": "node worker-test.mjs",
    "test:engine": "node engine-test.mjs",
    "test:coach": "node coach-test.mjs",
    "test:drills": "node drills-test.mjs",
    "test:sw": "node sw-test.mjs",
    "test:a11y": "node a11y-test.mjs",
    "test:3d": "node test-3d-toggle.mjs",
    "shots": "node shots.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "vendor:babylon": "node scripts/vendor-babylon.mjs",
    "preview": "node preview/render-preview.mjs",
    "preview:verify": "node preview/verify-board.mjs"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.32.0",
    "@babylonjs/havok": "^1.3.14",
    "esbuild": "^0.28.1",
    "puppeteer": "^25.10.0",
    "wrangler": "^4.131.1"
  }
}
